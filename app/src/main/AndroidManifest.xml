<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos Vehicle SDK 읽기 권한 (RoadMate에서 쓰는 도메인) -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />   <!-- Door -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />   <!-- Seat: 탑승 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />   <!-- Odometer, DrivingMode -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />  <!-- EvBattery -->
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" /> <!-- Wiper, Window -->
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" /> <!-- 공조, 사이드미러 열선, 핸들 열선 -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />  <!-- 전조등, 방향지시등 -->
    <uses-permission android:name="pleos.car.permission.CAR_MIRRORS" /> <!-- 사이드미러 -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />  <!-- 경고등 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />        <!-- 내비 경로·안내 정보 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" /> <!-- 내비 장소 검색 -->

    <!-- 준비 중 SDK (시험) -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" /> <!-- 위치 (dangerous: 실행 중 허용 필요) -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />    <!-- 음성 인식 -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />    <!-- 음성 안내 -->
    <!-- [ajh 시험] 안드로이드 표준 차량 속도 -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />

    <!-- 차량(Automotive) 앱 선언 -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_yeonsu"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_yeonsu_round"
        android:theme="@style/Theme.Test">

        <!-- 옛 SDK 연결 확인 화면: 앱 목록에는 나타나지 않게 런처 등록을 뺐다(내비 연동 코드가 이 이름으로 호출하지 않음) -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- 연저씨 · 로딩 화면 (앱 목록의 연저씨 아이콘이 여는 화면, 약 1초 후 시작 화면) -->
        <activity
            android:name=".yeonsu.LoadingActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Yeonsu"
            android:icon="@mipmap/ic_yeonsu"
            android:roundIcon="@mipmap/ic_yeonsu_round"
            android:label="연저씨">
            <!-- 앱을 여는 첫 화면도 주행 중에 막히지 않게 한다(플레오스 홈이 작업의 첫 화면으로 판단함) -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".yeonsu.StartActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Yeonsu"
            android:label="연저씨" />

        <activity
            android:name=".yeonsu.HomeActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Yeonsu"
            android:label="연저씨" />

        <activity
            android:name=".yeonsu.DriveLoadingActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Yeonsu"
            android:label="연저씨">
            <!-- 주행 중에도 열리는 화면(운전 방해 제한 예외). 일반 주행 안내 화면만 표시한다. -->
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>
        <activity
            android:name=".yeonsu.DriveActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:theme="@style/Theme.Yeonsu"
            android:label="연저씨">
            <!-- 주행 중에도 열리는 화면(운전 방해 제한 예외). 일반 주행 안내 화면만 표시한다. -->
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>
        <activity
            android:name=".yeonsu.QuestTypesActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:theme="@style/Theme.Yeonsu"
            android:label="연저씨" />
        <activity
            android:name=".yeonsu.QuestListActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:theme="@style/Theme.Yeonsu"
            android:label="연저씨" />
        <activity
            android:name=".yeonsu.QuestDetailActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:theme="@style/Theme.Yeonsu"
            android:label="연저씨" />
        <activity
            android:name=".yeonsu.RecordsActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:theme="@style/Theme.Yeonsu"
            android:label="연저씨" />
        <activity
            android:name=".yeonsu.ScenarioActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:theme="@style/Theme.Yeonsu"
            android:label="연저씨" />
        <activity
            android:name=".yeonsu.DailyFlowActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:theme="@style/Theme.Yeonsu"
            android:label="연저씨" />
    </application>
</manifest>
